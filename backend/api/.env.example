# Reference only: Docker uses compose.yaml and the root .env. Never put secrets here.
APP_NAME=Taller
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=taller
DB_USERNAME=taller
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_HMAC_KEY=

EXECUTOR_URL=http://executor:8080
EXECUTOR_TOKEN=
EXECUTOR_RUNTIME=runsc
EXECUTOR_MAX_CONCURRENT=4
EXECUTOR_DOCKER_GID=
RUNS_DB_USERNAME=taller
RUNS_DB_PASSWORD=

RUNS_QUOTA_ACTIVE=1
RUNS_QUOTA_PER_MINUTE=10
RUNS_QUOTA_PER_DAY=300
RUNS_QUOTA_SANDBOX_MINUTES=30
RUNS_QUEUE_MAX_WAITING=32
RUNS_THROTTLE_PER_MINUTE=30
RUNS_EXPIRY_QUEUED_SECONDS=600
RUNS_EXPIRY_RUNNING_SECONDS=140
RUNS_QUEUE_RETRY_AFTER=140
