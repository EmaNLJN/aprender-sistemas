{
  "name": "taller-rust-go",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Editor local del taller interactivo de Rust y Go",
  "scripts": {
    "curriculum": "node tools/content/build-curriculum.ts",
    "predev": "npm run curriculum",
    "dev": "vite --config frontend/vite.config.ts",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "pretypecheck": "npm run curriculum",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.qa.json && tsc --noEmit -p qa/e2e/tsconfig.json",
    "test:e2e": "playwright test --config qa/e2e/playwright.config.ts",
    "test:e2e:install": "playwright install --only-shell chromium",
    "preview": "vite preview --config frontend/vite.config.ts",
    "check:content": "node qa/content-check.ts",
    "check:runner": "node qa/runner-check.ts",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "check:lab": "node qa/lab-state-check.ts",
    "pretest": "npm run typecheck",
    "test": "node qa/run-checks.ts && vitest run --config frontend/vitest.config.ts",
    "test:unit": "vitest run --config frontend/vitest.config.ts",
    "pretest:unit": "npm run curriculum",
    "test:executor": "sh backend/executor/scripts/test.sh",
    "test:executor:integration": "sh backend/executor/scripts/integration.sh",
    "api:test": "docker compose --profile test run --rm --build test",
    "api:test:down": "sh backend/api/scripts/test-down.sh",
    "api:format:check": "docker compose --profile test run --rm --build --no-deps --entrypoint php test vendor/bin/pint --test",
    "api:analyse": "docker compose --profile test run --rm --build --no-deps --entrypoint php test vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
    "api:smoke": "sh backend/api/scripts/smoke.sh",
    "api:content:check": "node qa/api-content-check.ts",
    "api:sync:check": "node qa/api-sync-check.ts",
    "api:import:check": "node qa/api-import-check.ts",
    "api:runs:check": "node qa/api-runs-check.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "canvas-confetti": "1.9.4",
    "codemirror": "6.0.2",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
