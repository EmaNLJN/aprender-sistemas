        "    }",
        "}",
        "",
        "func main() {",
        "    __tallerCheck(\"t1\", func() bool { return strings.Join(Ordenar([]string{\"b\", \"a\"}), \"\") == \"ab\" })",
        "    fmt.Println(\"__TALLER_END__0123456789abcdef0123456789abcdef:1\")",
        "}"
